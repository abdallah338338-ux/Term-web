{
  "name": "bank-info",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "bank-info",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "webhook-bank-info",
      "name": "Webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COALESCE(MAX(lecture_number), 0)::int AS lecture_count, COUNT(*)::int AS total_questions FROM question_bank WHERE subject_id = '{{ $json.query.subject_id }}';",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [260, 0],
      "id": "get-stats",
      "name": "Get Bank Stats",
      "credentials": {
        "postgres": {
          "id": "supabase-postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"lecture_count\": {{ $json.lecture_count || 0 }},\n  \"total_questions\": {{ $json.total_questions || 0 }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 0],
      "id": "respond-stats",
      "name": "Respond with Stats"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Get Bank Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Bank Stats": {
      "main": [
        [
          {
            "node": "Respond with Stats",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
